<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Mastery - Opgaver & Overblik</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        /* TEMAER */
        :root, [data-theme="github"] {
            --bg: #0d1117;
            --sidebar-bg: #161b22;
            --card-bg: #21262d;
            --card-hover: #30363d;
            --border-color: #30363d;
            --input-bg: #0d1117;
            --text-main: #f0f6fc;
            --text-muted: #8b949e;
            --accent: #238636;
            --accent-hover: #2ea043;
            --star-color: #e3b341;
        }

        [data-theme="tokyonight"] {
            --bg: #1a1b26;
            --sidebar-bg: #16161e;
            --card-bg: #24283b;
            --card-hover: #2f354f;
            --border-color: #414868;
            --input-bg: #16161e;
            --text-main: #c0caf5;
            --text-muted: #7aa2f7;
            --accent: #7dcfff;
            --accent-hover: #2ac3de;
            --star-color: #e0af68;
        }

        /* BEHAGELIGT DÆMPET MELLEM-LYST TEMA (SOFT SLATE) */
        [data-theme="nordicfrost"] {
            --bg: #e2e8f0;
            --sidebar-bg: #cbd5e1;
            --card-bg: #ffffff;
            --card-hover: #f1f5f9;
            --border-color: #94a3b8;
            --input-bg: #f8fafc;
            --text-main: #0f172a;
            --text-muted: #475569;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --star-color: #d97706;
        }

        [data-theme="onedark"] {
            --bg: #21252b;
            --sidebar-bg: #1e2227;
            --card-bg: #2c313a;
            --card-hover: #3e4451;
            --border-color: #3e4451;
            --input-bg: #1b1d23;
            --text-main: #abb2bf;
            --text-muted: #61afef;
            --accent: #98c379;
            --accent-hover: #e5c07b;
            --star-color: #e5c07b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        button, input, select, textarea { font: inherit; }

        .app-layout {
            display: flex;
            width: 100vw;
            height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 20px 14px;
            gap: 20px;
            flex-shrink: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            padding: 0 8px;
            letter-spacing: -0.3px;
        }

        .nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            list-style: none;
        }

        .nav-item-btn {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px 12px;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: left;
        }

        .nav-item-btn:hover {
            background: rgba(0, 0, 0, 0.05);
            color: var(--text-main);
        }

        .nav-item-btn.active {
            background: var(--accent);
            color: #ffffff;
        }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 24px;
            gap: 20px;
            position: relative;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--sidebar-bg);
            padding: 12px 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        select, .search-input, input[type="text"], input[type="date"], input[type="number"] {
            background: var(--input-bg);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 0.85rem;
            outline: none;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary:hover { background: var(--accent-hover); }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
        }

        .btn-secondary:hover { color: var(--text-main); border-color: var(--text-muted); }

        .btn-danger {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.15s ease;
        }
        .btn-danger:hover {
            background: #ef4444;
            color: #ffffff;
        }

        .page { display: none; }
        .page.active { display: block; }

        /* Dashboard & Gauges */
        .cockpit-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }

        .gauge-card {
            background: var(--sidebar-bg);
            padding: 16px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: transform 0.15s ease, border-color 0.15s ease;
        }

        .gauge-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent);
        }

        .gauge-val { font-size: 1.6rem; font-weight: 800; }

        /* Calendar Grid */
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 16px;
        }

        .calendar-col {
            background: var(--sidebar-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 16px;
            min-height: 250px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .calendar-col-title {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            padding-bottom: 8px;
            border-bottom: 2px solid var(--border-color);
        }

        /* Kanban Board */
        .kanban-board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            align-items: start;
        }

        .kanban-col {
            background: var(--sidebar-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 16px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .kanban-col-header {
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--border-color);
        }

        .kanban-card, .cal-card-item {
            background: var(--card-bg);
            border-radius: 8px;
            border: 1px solid var(--border-color);
            padding: 14px;
            cursor: grab;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: transform 0.15s, border-color 0.15s;
        }

        .kanban-card:hover, .cal-card-item:hover {
            transform: translateY(-2px);
            border-color: var(--accent);
        }

        .tag-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            background: rgba(0, 0, 0, 0.06);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            margin-right: 4px;
        }

        /* PROGRESS BAR STYLING */
        .progress-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
        }

        .progress-bar-bg {
            flex-grow: 1;
            height: 6px;
            background: rgba(0, 0, 0, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--accent);
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        .progress-bar-fill.done { background: #10b981; }

        /* Task Table Clean Styling */
        .task-table-container {
            background: var(--sidebar-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow-x: auto;
        }

        table { width: 100%; border-collapse: collapse; }
        
        th {
            background: var(--input-bg);
            padding: 12px 16px;
            text-align: left;
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        th.sortable {
            cursor: pointer;
            user-select: none;
        }
        th.sortable:hover {
            color: var(--text-main);
            background: rgba(0, 0, 0, 0.03);
        }

        td { padding: 12px 16px; border-bottom: 1px solid var(--border-color); font-size: 0.85rem; }
        
        tr.task-row:hover { background: var(--card-hover); }

        .task-name-cell {
            cursor: pointer;
            font-weight: 600;
            transition: color 0.15s ease;
        }
        .task-name-cell:hover {
            color: var(--accent);
        }

        /* ELEGANT DISKRET REDIGERING I TABEL */
        .clean-clickable-cell {
            cursor: pointer;
            padding: 4px 6px;
            border-radius: 4px;
            display: inline-block;
            transition: background 0.15s ease;
        }
        .clean-clickable-cell:hover {
            background: rgba(0, 0, 0, 0.08);
        }

        .inline-edit-input {
            background: var(--input-bg);
            color: var(--text-main);
            border: 1px solid var(--accent);
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 0.85rem;
            outline: none;
        }

        .clickable-toggle {
            cursor: pointer;
            font-size: 1rem;
            user-select: none;
        }

        .prio-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
        }
        .prio-Høj { background: rgba(239, 68, 68, 0.18); color: #dc2626; }
        .prio-Mellem { background: rgba(245, 158, 11, 0.18); color: #d97706; }
        .prio-Lav { background: rgba(6, 182, 212, 0.18); color: #0891b2; }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            background: rgba(0, 0, 0, 0.04);
            border: 1px solid var(--border-color);
            cursor: pointer;
        }

        .settings-wrapper { position: relative; }
        .settings-dropdown {
            display: none;
            position: absolute;
            right: 0; top: 40px;
            width: 230px;
            background: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 10px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            z-index: 100;
            flex-direction: column;
            gap: 8px;
        }
        .settings-dropdown.open { display: flex; }

        .settings-group-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            margin-top: 4px;
            padding: 0 4px;
        }

        /* FOOTER / RIGHTS STYLING */
        .rights-footer {
            margin-top: auto;
            padding-top: 16px;
            text-align: right;
            font-size: 0.75rem;
            color: var(--text-muted);
            opacity: 0.8;
            user-select: none;
        }

        /* Modal Popup */
        .modal-overlay {
            display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000;
            justify-content: center; align-items: center;
        }
        .modal-overlay.open { display: flex; }
        .modal-card {
            position: relative;
            width: min(650px, 92vw); background: var(--sidebar-bg); border: 1px solid var(--border-color);
            border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 16px;
            max-height: 88vh; overflow-y: auto;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--sidebar-bg);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }

        .modal-close-red {
            position: absolute;
            top: 14px;
            right: 14px;
            background: #ef4444;
            color: #ffffff;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: background 0.15s ease, transform 0.15s ease;
            z-index: 10;
        }
        .modal-close-red:hover {
            background: #dc2626;
            transform: scale(1.05);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 8px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
        }

        .subtask-item {
            display: flex; align-items: center; gap: 8px; margin-top: 6px;
        }
        .subtask-item input[type="text"] {
            flex-grow: 1; background: var(--input-bg); border: 1px solid var(--border-color);
            padding: 6px 10px; border-radius: 4px; color: var(--text-main);
        }
        .subtask-delete-btn {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .subtask-delete-btn:hover {
            background: #ef4444;
            color: #ffffff;
        }

        .comments-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 8px;
            max-height: 180px;
            overflow-y: auto;
        }

        .comment-item {
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .comment-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .comment-text {
            font-size: 0.85rem;
            color: var(--text-main);
            white-space: pre-wrap;
        }

        .comment-input-row {
            display: flex;
            gap: 8px;
        }

        .comment-input-row input {
            flex-grow: 1;
        }

        .filter-status-bar {
            display: none;
            align-items: center;
            justify-content: space-between;
            background: rgba(37, 99, 235, 0.12);
            border: 1px solid var(--accent);
            padding: 8px 14px;
            border-radius: 8px;
            margin-bottom: 12px;
            font-size: 0.85rem;
        }
        .filter-status-bar.active { display: flex; }
    </style>
</head>
<body>

    <div class="app-layout">
        <aside class="sidebar">
            <div class="brand">
                <i class="fa-solid fa-chess-knight" style="color: var(--accent);"></i> Task Mastery
            </div>
            <ul class="nav-list">
                <li><button class="nav-item-btn active" id="nav-db" onclick="switchPage('dashboard')"><i class="fa-solid fa-chart-pie"></i> Dashboard</button></li>
                <li><button class="nav-item-btn" id="nav-board" onclick="switchPage('board')"><i class="fa-solid fa-square-poll-vertical"></i> Kanban Tavle</button></li>
                <li><button class="nav-item-btn" id="nav-tasks" onclick="switchPage('tasks')"><i class="fa-solid fa-list-check"></i> Opgaver</button></li>
            </ul>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <select id="periodSelect" onchange="setDashboardPeriod(this.value)">
                        <option value="7">1 Uge</option>
                        <option value="30">30 Dage</option>
                        <option value="90" selected>3 Måneder</option>
                        <option value="365">Hele Året</option>
                    </select>

                    <select id="responsibleFilter" onchange="render()">
                        <option value="all">Ansvarlig: Alle</option>
                        <option value="mine" selected>Ansvarlig: Kun mig (✅)</option>
                        <option value="not_mine">Ansvarlig: Ikke mig (❌)</option>
                    </select>
                </div>

                <div class="topbar-right">
                    <button class="btn-primary" onclick="addNewTask()"><i class="fa-solid fa-plus"></i> Ny opgave</button>
                    
                    <div class="settings-wrapper">
                        <button class="btn-secondary" onclick="toggleSettingsMenu()"><i class="fa-solid fa-gear"></i></button>
                        <div class="settings-dropdown" id="settingsDropdown">
                            <div class="settings-group-title"><i class="fa-solid fa-palette"></i> Vælg Tema</div>
                            <select id="themeSelect" onchange="changeTheme(this.value)" style="width:100%;">
                                <option value="github" selected>GitHub Dark</option>
                                <option value="nordicfrost">Soft Slate (Dæmpet lyst)</option>
                                <option value="tokyonight">Tokyo Night</option>
                                <option value="onedark">One Dark Pro</option>
                            </select>
                            
                            <hr style="border:none; border-top:1px solid var(--border-color); margin:4px 0;">
                            
                            <div class="settings-group-title"><i class="fa-solid fa-database"></i> Data & Backup</div>
                            <button class="btn-secondary" style="width:100%; text-align:left;" onclick="toggleFullscreen()"><i class="fa-solid fa-expand"></i> Fuldskærm</button>
                            <button class="btn-secondary" style="width:100%; text-align:left;" onclick="exportDataToFile()"><i class="fa-solid fa-download"></i> Gem backup</button>
                            <button class="btn-secondary" style="width:100%; text-align:left;" onclick="triggerImportFile()"><i class="fa-solid fa-upload"></i> Hent backup</button>
                            <button class="btn-danger" style="width:100%; text-align:left;" onclick="deleteAllTasks()"><i class="fa-solid fa-trash"></i> Slet alle opgaver</button>
                            <input type="file" id="backupFileInput" style="display:none;" accept=".json" onchange="importDataFromFile(event)">
                        </div>
                    </div>
                </div>
            </header>

            <div id="page-dashboard" class="page active">
                <div class="cockpit-grid">
                    <div class="gauge-card" onclick="filterByGauge('Fuldført')">
                        <div><div>Færdige</div><div class="gauge-val" id="val-done" style="color:#10b981;">0</div></div>
                        <i class="fa-solid fa-circle-check fa-2x" style="color:#10b981; opacity:0.3;"></i>
                    </div>
                    <div class="gauge-card" onclick="filterByGauge('Igangsat')">
                        <div><div>I gang</div><div class="gauge-val" id="val-active" style="color:#0284c7;">0</div></div>
                        <i class="fa-solid fa-spinner fa-2x" style="color:#0284c7; opacity:0.3;"></i>
                    </div>
                    <div class="gauge-card" onclick="filterByGauge('Kritiske')">
                        <div><div>Kritiske</div><div class="gauge-val" id="val-late" style="color:#ef4444;">0</div></div>
                        <i class="fa-solid fa-triangle-exclamation fa-2x" style="color:#ef4444; opacity:0.3;"></i>
                    </div>
                    <div class="gauge-card" onclick="filterByGauge('Venter')">
                        <div><div>Venter</div><div class="gauge-val" id="val-todo" style="color:#d97706;">0</div></div>
                        <i class="fa-solid fa-clock fa-2x" style="color:#d97706; opacity:0.3;"></i>
                    </div>
                </div>

                <h3 style="margin-top:20px; font-size:1rem; color:var(--text-muted);"><i class="fa-solid fa-calendar-week"></i> UGEPLAN</h3>
                <div class="calendar-grid">
                    <div class="calendar-col" ondragover="event.preventDefault()" ondrop="handleCalDrop('Mandag-onsdag', event)">
                        <div class="calendar-col-title">Mandag - Onsdag</div>
                        <div id="cal-list-mon-wed" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                    <div class="calendar-col" ondragover="event.preventDefault()" ondrop="handleCalDrop('Torsdag', event)">
                        <div class="calendar-col-title">Torsdag</div>
                        <div id="cal-list-thu" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                    <div class="calendar-col" ondragover="event.preventDefault()" ondrop="handleCalDrop('Fredag', event)">
                        <div class="calendar-col-title">Fredag</div>
                        <div id="cal-list-fri" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                </div>
            </div>

            <div id="page-board" class="page">
                <div class="kanban-board">
                    <div class="kanban-col" ondragover="event.preventDefault()" ondrop="handleKanbanDrop('Venter', event)">
                        <div class="kanban-col-header">Venter <span id="cnt-todo">0</span></div>
                        <div id="kanban-list-todo" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                    <div class="kanban-col" ondragover="event.preventDefault()" ondrop="handleKanbanDrop('Igangsat', event)">
                        <div class="kanban-col-header">I gang <span id="cnt-active">0</span></div>
                        <div id="kanban-list-active" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                    <div class="kanban-col" ondragover="event.preventDefault()" ondrop="handleKanbanDrop('Fuldført', event)">
                        <div class="kanban-col-header">Fuldført <span id="cnt-done">0</span></div>
                        <div id="kanban-list-done" style="display:flex; flex-direction:column; gap:10px;"></div>
                    </div>
                </div>
            </div>

            <div id="page-tasks" class="page">
                <div id="filterStatusBar" class="filter-status-bar">
                    <span>Viser filter: <strong id="filterStatusText"></strong></span>
                    <button class="btn-secondary" onclick="clearGaugeFilter()" style="padding:4px 8px; font-size:0.75rem;"><i class="fa-solid fa-xmark"></i> Vis alle opgaver</button>
                </div>

                <div style="margin-bottom:12px;">
                    <input type="text" id="taskSearchInput" placeholder="Søg i opgaver..." oninput="render()" style="width:300px;">
                </div>
                <div class="task-table-container">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:50px; text-align:center;">Ansvar</th>
                                <th style="width:40px; text-align:center;">Fokus</th>
                                <th>Opgavebeskrivelse</th>
                                <th style="width:130px;">Planlagt dag</th>
                                <th class="sortable" style="width:120px;" onclick="sortTable('date')">Dato <span id="sort-icon-date"></span></th>
                                <th class="sortable" style="width:100px;" onclick="sortTable('priority')">Prioritet <span id="sort-icon-priority"></span></th>
                                <th class="sortable" style="width:110px;" onclick="sortTable('status')">Status <span id="sort-icon-status"></span></th>
                                <th class="sortable" style="width:160px;" onclick="sortTable('pct')">Fremdrift <span id="sort-icon-pct"></span></th>
                            </tr>
                        </thead>
                        <tbody id="taskTableBody"></tbody>
                    </table>
                </div>
            </div>

            <footer class="rights-footer">
                All rights reserved Lasse Gamborg
            </footer>
        </main>
    </div>

    <div class="modal-overlay" id="noteModal">
        <div class="modal-card">
            <button class="modal-close-red" onclick="closeNoteModal()"><i class="fa-solid fa-xmark"></i></button>
            
            <h3 style="padding-right:40px;">Rediger opgave</h3>
            
            <div class="form-grid">
                <div class="form-group full-width">
                    <label>Opgavebeskrivelse</label>
                    <input type="text" id="modalTaskNameInput">
                </div>

                <div class="form-group">
                    <label>Ansvarlig</label>
                    <select id="modalResponsibleInput">
                        <option value="true">✅ Mig</option>
                        <option value="false">❌ Ikke mig</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Primært fokus (⭐)</label>
                    <select id="modalFrogInput">
                        <option value="true">⭐ Ja (Fokus)</option>
                        <option value="false">Nej</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Planlagt dag</label>
                    <select id="modalPlannedDayInput">
                        <option value="Ikke planlagt">Ikke planlagt</option>
                        <option value="Mandag-onsdag">Mandag - Onsdag</option>
                        <option value="Torsdag">Torsdag</option>
                        <option value="Fredag">Fredag</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Planlagt dato</label>
                    <input type="date" id="modalDateInput">
                </div>

                <div class="form-group">
                    <label>Prioritet</label>
                    <select id="modalPriorityInput">
                        <option value="Lav">Lav</option>
                        <option value="Mellem">Mellem</option>
                        <option value="Høj">Høj</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select id="modalStatusInput">
                        <option value="Venter">Venter</option>
                        <option value="Igangsat">Igangsat</option>
                        <option value="Fuldført">Fuldført</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label>Fremdrift i %</label>
                    <input type="number" id="modalPctInput" min="0" max="100">
                </div>

                <div class="form-group full-width">
                    <label><i class="fa-solid fa-comments"></i> Kommentarer & Noter</label>
                    <div class="comment-input-row">
                        <input type="text" id="modalNewCommentInput" placeholder="Skriv en kommentar og tryk Enter..." onkeydown="if(event.key==='Enter'){addComment();}">
                        <button class="btn-primary" onclick="addComment()">Tilføj</button>
                    </div>
                    <div id="commentsContainer" class="comments-list"></div>
                </div>

                <div class="form-group full-width">
                    <label>Tags (kommasepareret)</label>
                    <input type="text" id="modalTagsInput" placeholder="f.eks. esop, drift, 6S">
                </div>
            </div>

            <div class="form-group full-width">
                <label>Underopgaver / Tjekliste</label>
                <div id="subtasksContainer"></div>
                <button class="btn-secondary" onclick="addSubtaskRow()" style="margin-top:6px;"><i class="fa-solid fa-plus"></i> Tilføj underopgave</button>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:10px;">
                <button class="btn-secondary" style="color:#ef4444; border-color:#ef4444;" onclick="deleteCurrentTask()"><i class="fa-solid fa-trash"></i> Slet opgave</button>
                <button class="btn-primary" onclick="saveTaskDetails()"><i class="fa-solid fa-check"></i> Gem ændringer</button>
            </div>
        </div>
    </div>

    <script>
        const STORAGE_KEY = 'taskmaster-clean-state-v2';

        let state = {
            tasks: [],
            activeEditingTaskId: null,
            draggedTaskId: null,
            dashboardPeriodDays: 90,
            theme: 'github',
            activeGaugeFilter: null,
            sortColumn: null,
            sortDirection: 'asc'
        };

        function formatDateDanish(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            return dateStr;
        }

        function loadState() {
            let raw = localStorage.getItem(STORAGE_KEY);
            
            if (raw) {
                try {
                    state.tasks = JSON.parse(raw);
                } catch(e) {
                    state.tasks = [];
                }
            } else {
                state.tasks = [];
            }
            saveState();

            const savedTheme = localStorage.getItem('workflowdash-theme') || 'github';
            changeTheme(savedTheme);
        }

        function toggleFullscreen() {
            document.getElementById('settingsDropdown').classList.remove('open');
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    alert(`Fejl ved aktivering af fuldskærm: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        function deleteAllTasks() {
            document.getElementById('settingsDropdown').classList.remove('open');
            if (confirm('ER DU SIKKER?\n\nDette vil permanent slette ALLE opgaver i listen. Handlingen kan ikke fortrydes!')) {
                state.tasks = [];
                saveState();
                render();
                alert('Alle opgaver er nu slettet.');
            }
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state.tasks));
        }

        function changeTheme(themeName) {
            state.theme = themeName;
            document.body.setAttribute('data-theme', themeName);
            document.getElementById('themeSelect').value = themeName;
            localStorage.setItem('workflowdash-theme', themeName);
        }

        function switchPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(`page-${page}`).classList.add('active');
            document.getElementById(`nav-${page === 'board' ? 'board' : page === 'dashboard' ? 'db' : 'tasks'}`).classList.add('active');
            render();
        }

        function filterByGauge(statusType) {
            state.activeGaugeFilter = statusType;
            switchPage('tasks');
        }

        function clearGaugeFilter() {
            state.activeGaugeFilter = null;
            render();
        }

        function sortTable(column) {
            if (state.sortColumn === column) {
                state.sortDirection = state.sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                state.sortColumn = column;
                state.sortDirection = 'asc';
            }
            renderTable();
        }

        function toggleSettingsMenu() {
            document.getElementById('settingsDropdown').classList.toggle('open');
        }

        window.addEventListener('click', (e) => {
            if (!e.target.closest('.settings-wrapper')) {
                document.getElementById('settingsDropdown').classList.remove('open');
            }
        });

        function setDashboardPeriod(val) {
            state.dashboardPeriodDays = Number(val);
            render();
        }

        function updateTaskField(taskId, field, value) {
            const task = state.tasks.find(t => t.id === taskId);
            if (!task) return;

            if (field === 'responsible' || field === 'isFrog') {
                task[field] = value;
            } else if (field === 'pct') {
                let numVal = Math.min(100, Math.max(0, Number(value) || 0));
                task.pct = numVal;
                if (numVal === 100) task.status = 'Fuldført';
                else if (numVal > 0 && task.status === 'Venter') task.status = 'Igangsat';
            } else if (field === 'status') {
                task.status = value;
                if (value === 'Fuldført') task.pct = 100;
            } else {
                task[field] = value;
            }

            saveState();
            render();
        }

        /* STILREN RENDER AF ENKELTINLINE FELTER */
        function triggerInlineEdit(taskId, type) {
            const task = state.tasks.find(t => t.id === taskId);
            if (!task) return;

            const cell = document.getElementById(`cell-${type}-${taskId}`);
            if (!cell) return;

            if (type === 'day') {
                cell.innerHTML = `
                    <select class="inline-edit-input" onchange="updateTaskField('${taskId}', 'plannedDay', this.value)" onblur="renderTable()">
                        <option value="Ikke planlagt" ${task.plannedDay === 'Ikke planlagt' ? 'selected' : ''}>Ikke planlagt</option>
                        <option value="Mandag-onsdag" ${task.plannedDay === 'Mandag-onsdag' ? 'selected' : ''}>Mandag-onsdag</option>
                        <option value="Torsdag" ${task.plannedDay === 'Torsdag' ? 'selected' : ''}>Torsdag</option>
                        <option value="Fredag" ${task.plannedDay === 'Fredag' ? 'selected' : ''}>Fredag</option>
                    </select>
                `;
            } else if (type === 'date') {
                cell.innerHTML = `
                    <input type="date" class="inline-edit-input" value="${task.date}" onchange="updateTaskField('${taskId}', 'date', this.value)" onblur="renderTable()">
                `;
            } else if (type === 'prio') {
                cell.innerHTML = `
                    <select class="inline-edit-input" onchange="updateTaskField('${taskId}', 'priority', this.value)" onblur="renderTable()">
                        <option value="Lav" ${task.priority === 'Lav' ? 'selected' : ''}>Lav</option>
                        <option value="Mellem" ${task.priority === 'Mellem' ? 'selected' : ''}>Mellem</option>
                        <option value="Høj" ${task.priority === 'Høj' ? 'selected' : ''}>Høj</option>
                    </select>
                `;
            } else if (type === 'status') {
                cell.innerHTML = `
                    <select class="inline-edit-input" onchange="updateTaskField('${taskId}', 'status', this.value)" onblur="renderTable()">
                        <option value="Venter" ${task.status === 'Venter' ? 'selected' : ''}>Venter</option>
                        <option value="Igangsat" ${task.status === 'Igangsat' ? 'selected' : ''}>Igangsat</option>
                        <option value="Fuldført" ${task.status === 'Fuldført' ? 'selected' : ''}>Fuldført</option>
                    </select>
                `;
            } else if (type === 'pct') {
                cell.innerHTML = `
                    <input type="number" class="inline-edit-input" style="width:60px;" min="0" max="100" value="${task.pct}" onchange="updateTaskField('${taskId}', 'pct', this.value)" onblur="renderTable()"> %
                `;
            }

            const activeElem = cell.querySelector('input, select');
            if (activeElem) {
                activeElem.focus();
                if (activeElem.showPicker && activeElem.type === 'date') {
                    try { activeElem.showPicker(); } catch(e) {}
                }
            }
        }

        function getFilteredTasks() {
            const respFilter = document.getElementById('responsibleFilter').value;
            const search = document.getElementById('taskSearchInput') ? document.getElementById('taskSearchInput').value.toLowerCase() : '';

            let list = state.tasks.filter(t => {
                if (respFilter === 'mine' && !t.responsible) return false;
                if (respFilter === 'not_mine' && t.responsible) return false;
                if (search && !t.name.toLowerCase().includes(search)) return false;

                if (state.activeGaugeFilter) {
                    if (state.activeGaugeFilter === 'Kritiske') {
                        if (t.status === 'Fuldført' || new Date(t.date) >= new Date()) return false;
                    } else {
                        if (t.status !== state.activeGaugeFilter) return false;
                    }
                }

                return true;
            });

            if (state.sortColumn) {
                const prioOrder = { 'Høj': 3, 'Mellem': 2, 'Lav': 1 };
                const statusOrder = { 'Venter': 1, 'Igangsat': 2, 'Fuldført': 3 };

                list.sort((a, b) => {
                    let valA = a[state.sortColumn];
                    let valB = b[state.sortColumn];

                    if (state.sortColumn === 'priority') {
                        valA = prioOrder[valA] || 0;
                        valB = prioOrder[valB] || 0;
                    } else if (state.sortColumn === 'status') {
                        valA = statusOrder[valA] || 0;
                        valB = statusOrder[valB] || 0;
                    } else if (state.sortColumn === 'pct') {
                        valA = Number(valA) || 0;
                        valB = Number(valB) || 0;
                    }

                    if (valA < valB) return state.sortDirection === 'asc' ? -1 : 1;
                    if (valA > valB) return state.sortDirection === 'asc' ? 1 : -1;
                    return 0;
                });
            }

            return list;
        }

        function render() {
            renderDashboard();
            renderCalendar();
            renderKanban();
            renderTable();
        }

        function renderDashboard() {
            const tasks = state.tasks.filter(t => {
                const respFilter = document.getElementById('responsibleFilter').value;
                if (respFilter === 'mine' && !t.responsible) return false;
                if (respFilter === 'not_mine' && t.responsible) return false;
                return true;
            });

            document.getElementById('val-done').textContent = tasks.filter(t => t.status === 'Fuldført').length;
            document.getElementById('val-active').textContent = tasks.filter(t => t.status === 'Igangsat').length;
            document.getElementById('val-todo').textContent = tasks.filter(t => t.status === 'Venter').length;
            document.getElementById('val-late').textContent = tasks.filter(t => t.status !== 'Fuldført' && new Date(t.date) < new Date()).length;
        }

        function createProgressBarHtml(pct) {
            const isDone = pct === 100;
            return `
                <div class="progress-wrapper">
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill ${isDone ? 'done' : ''}" style="width: ${pct}%;"></div>
                    </div>
                </div>
            `;
        }

        function renderCalendar() {
            const listMonWed = document.getElementById('cal-list-mon-wed');
            const listThu = document.getElementById('cal-list-thu');
            const listFri = document.getElementById('cal-list-fri');

            listMonWed.innerHTML = ''; listThu.innerHTML = ''; listFri.innerHTML = '';

            getFilteredTasks().forEach(task => {
                const card = `
                    <div class="cal-card-item" draggable="true" ondragstart="state.draggedTaskId='${task.id}'" onclick="openNoteModal('${task.id}')">
                        <div style="font-weight:600;">${task.name}</div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            ${createProgressBarHtml(task.pct)}
                            <span style="font-weight:700; font-size:0.8rem;">${task.pct}%</span>
                        </div>
                        <div style="font-size:0.75rem; color:var(--text-muted);">Dato: ${formatDateDanish(task.date)}</div>
                    </div>
                `;
                if (task.plannedDay === 'Mandag-onsdag') listMonWed.insertAdjacentHTML('beforeend', card);
                else if (task.plannedDay === 'Torsdag') listThu.insertAdjacentHTML('beforeend', card);
                else if (task.plannedDay === 'Fredag') listFri.insertAdjacentHTML('beforeend', card);
            });
        }

        function handleCalDrop(dayGroup, event) {
            event.preventDefault();
            const task = state.tasks.find(t => t.id === state.draggedTaskId);
            if (task) {
                task.plannedDay = dayGroup;
                saveState();
                render();
            }
        }

        function renderKanban() {
            const listTodo = document.getElementById('kanban-list-todo');
            const listActive = document.getElementById('kanban-list-active');
            const listDone = document.getElementById('kanban-list-done');

            listTodo.innerHTML = ''; listActive.innerHTML = ''; listDone.innerHTML = '';

            getFilteredTasks().forEach(task => {
                const tagsHtml = (task.tags || []).map(tag => `<span class="tag-badge">#${tag}</span>`).join('');
                const card = `
                    <div class="kanban-card" draggable="true" ondragstart="state.draggedTaskId='${task.id}'" onclick="openNoteModal('${task.id}')">
                        <div style="font-weight:600;">${task.name}</div>
                        <div>${tagsHtml}</div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            ${createProgressBarHtml(task.pct)}
                            <span style="font-weight:700; font-size:0.8rem;">${task.pct}%</span>
                        </div>
                        <div style="font-size:0.75rem; color:var(--text-muted);"><i class="fa-regular fa-calendar"></i> ${formatDateDanish(task.date)}</div>
                    </div>
                `;
                if (task.status === 'Venter') listTodo.insertAdjacentHTML('beforeend', card);
                else if (task.status === 'Igangsat') listActive.insertAdjacentHTML('beforeend', card);
                else if (task.status === 'Fuldført') listDone.insertAdjacentHTML('beforeend', card);
            });

            const tasks = getFilteredTasks();
            document.getElementById('cnt-todo').textContent = tasks.filter(t => t.status === 'Venter').length;
            document.getElementById('cnt-active').textContent = tasks.filter(t => t.status === 'Igangsat').length;
            document.getElementById('cnt-done').textContent = tasks.filter(t => t.status === 'Fuldført').length;
        }

        function handleKanbanDrop(newStatus, event) {
            event.preventDefault();
            const task = state.tasks.find(t => t.id === state.draggedTaskId);
            if (task) {
                task.status = newStatus;
                if (newStatus === 'Fuldført') task.pct = 100;
                saveState();
                render();
            }
        }

        function renderTable() {
            const tbody = document.getElementById('taskTableBody');
            tbody.innerHTML = '';

            const filterBar = document.getElementById('filterStatusBar');
            const filterText = document.getElementById('filterStatusText');

            if (state.activeGaugeFilter) {
                filterBar.classList.add('active');
                filterText.textContent = state.activeGaugeFilter;
            } else {
                filterBar.classList.remove('active');
            }

            ['date', 'priority', 'status', 'pct'].forEach(col => {
                const iconSpan = document.getElementById(`sort-icon-${col}`);
                if (iconSpan) {
                    if (state.sortColumn === col) {
                        iconSpan.textContent = state.sortDirection === 'asc' ? ' ▲' : ' ▼';
                    } else {
                        iconSpan.textContent = '';
                    }
                }
            });

            getFilteredTasks().forEach(task => {
                const commentCount = (task.comments || []).length;
                
                tbody.insertAdjacentHTML('beforeend', `
                    <tr class="task-row">
                        <td style="text-align:center;">
                            <span class="clickable-toggle" onclick="updateTaskField('${task.id}', 'responsible', ${!task.responsible})">
                                ${task.responsible ? '✅' : '❌'}
                            </span>
                        </td>
                        <td style="text-align:center;">
                            <span class="clickable-toggle" onclick="updateTaskField('${task.id}', 'isFrog', ${!task.isFrog})">
                                ${task.isFrog ? '⭐' : '☆'}
                            </span>
                        </td>
                        <td class="task-name-cell" onclick="openNoteModal('${task.id}')">
                            ${task.name} ${commentCount > 0 ? `<span style="font-size:0.75rem; color:var(--text-muted); margin-left:6px;"><i class="fa-solid fa-comment"></i> ${commentCount}</span>` : ''}
                        </td>
                        <td>
                            <div id="cell-day-${task.id}">
                                <span class="clean-clickable-cell" onclick="triggerInlineEdit('${task.id}', 'day')">
                                    ${task.plannedDay}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div id="cell-date-${task.id}">
                                <span class="clean-clickable-cell" onclick="triggerInlineEdit('${task.id}', 'date')">
                                    ${formatDateDanish(task.date)}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div id="cell-prio-${task.id}">
                                <span class="prio-badge prio-${task.priority}" onclick="triggerInlineEdit('${task.id}', 'prio')">
                                    ${task.priority}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div id="cell-status-${task.id}">
                                <span class="status-badge" onclick="triggerInlineEdit('${task.id}', 'status')">
                                    ${task.status}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;" id="cell-pct-${task.id}">
                                ${createProgressBarHtml(task.pct)}
                                <span class="clean-clickable-cell" style="font-weight:700; min-width:38px; text-align:right;" onclick="triggerInlineEdit('${task.id}', 'pct')">
                                    ${task.pct}%
                                </span>
                            </div>
                        </td>
                    </tr>
                `);
            });
        }

        function addNewTask() {
            const newTask = {
                id: 't' + Date.now(),
                name: 'Ny opgave',
                responsible: true,
                status: 'Igangsat',
                priority: 'Mellem',
                date: new Date().toISOString().split('T')[0],
                pct: 0,
                comments: [],
                isFrog: false,
                plannedDay: 'Ikke planlagt',
                tags: [],
                subtasks: []
            };
            state.tasks.unshift(newTask);
            saveState();
            render();
            openNoteModal(newTask.id);
        }

        function openNoteModal(id) {
            state.activeEditingTaskId = id;
            const task = state.tasks.find(t => t.id === id);
            if (!task) return;

            document.getElementById('modalTaskNameInput').value = task.name;
            document.getElementById('modalResponsibleInput').value = task.responsible ? "true" : "false";
            document.getElementById('modalFrogInput').value = task.isFrog ? "true" : "false";
            document.getElementById('modalPlannedDayInput').value = task.plannedDay || 'Ikke planlagt';
            document.getElementById('modalDateInput').value = task.date;
            document.getElementById('modalPriorityInput').value = task.priority;
            document.getElementById('modalStatusInput').value = task.status;
            document.getElementById('modalPctInput').value = task.pct;
            document.getElementById('modalTagsInput').value = (task.tags || []).join(', ');
            document.getElementById('modalNewCommentInput').value = '';

            renderComments(task.comments || []);
            renderSubtasks(task.subtasks || []);
            document.getElementById('noteModal').classList.add('open');
        }

        function closeNoteModal() {
            document.getElementById('noteModal').classList.remove('open');
            state.activeEditingTaskId = null;
        }

        function addComment() {
            const input = document.getElementById('modalNewCommentInput');
            const text = input.value.trim();
            if (!text) return;

            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (!task) return;

            if (!task.comments) task.comments = [];

            const now = new Date();
            const dateStr = `${String(now.getDate()).padStart(2, '0')}-${String(now.getMonth()+1).padStart(2, '0')}-${now.getFullYear()} kl. ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            task.comments.unshift({ text, date: dateStr });
            input.value = '';
            
            renderComments(task.comments);
            saveState();
            render();
        }

        function deleteComment(idx) {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (!task || !task.comments) return;

            task.comments.splice(idx, 1);
            renderComments(task.comments);
            saveState();
            render();
        }

        function renderComments(comments) {
            const container = document.getElementById('commentsContainer');
            container.innerHTML = '';

            if (comments.length === 0) {
                container.innerHTML = '<div style="font-size:0.8rem; color:var(--text-muted); font-style:italic;">Ingen kommentarer endnu.</div>';
                return;
            }

            comments.forEach((c, idx) => {
                container.insertAdjacentHTML('beforeend', `
                    <div class="comment-item">
                        <div class="comment-header">
                            <span>${c.date}</span>
                            <button class="btn-icon" style="font-size:0.75rem;" onclick="deleteComment(${idx})"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <div class="comment-text">${escapeHtml(c.text)}</div>
                    </div>
                `);
            });
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function renderSubtasks(subtasks) {
            const container = document.getElementById('subtasksContainer');
            container.innerHTML = '';
            subtasks.forEach((st, idx) => {
                container.insertAdjacentHTML('beforeend', `
                    <div class="subtask-item">
                        <input type="checkbox" ${st.done ? 'checked' : ''} onchange="toggleSubtask(${idx})">
                        <input type="text" value="${st.title}" onchange="updateSubtaskTitle(${idx}, this.value)">
                        <button class="subtask-delete-btn" onclick="deleteSubtask(${idx})"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `);
            });
        }

        function addSubtaskRow() {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (!task) return;
            if (!task.subtasks) task.subtasks = [];
            task.subtasks.push({ title: '', done: false });
            renderSubtasks(task.subtasks);
        }

        function deleteSubtask(idx) {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (!task || !task.subtasks) return;
            task.subtasks.splice(idx, 1);
            recalcTaskProgress(task);
            renderSubtasks(task.subtasks);
            saveState();
            render();
        }

        function toggleSubtask(idx) {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (!task) return;
            task.subtasks[idx].done = !task.subtasks[idx].done;
            recalcTaskProgress(task);
        }

        function updateSubtaskTitle(idx, val) {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (task) task.subtasks[idx].title = val;
        }

        function recalcTaskProgress(task) {
            if (task.subtasks && task.subtasks.length > 0) {
                const doneCount = task.subtasks.filter(s => s.done).length;
                task.pct = Math.round((doneCount / task.subtasks.length) * 100);
                if (task.pct === 100) task.status = 'Fuldført';
                else if (task.pct > 0 && task.status === 'Venter') task.status = 'Igangsat';
            }
        }

        function saveTaskDetails() {
            const task = state.tasks.find(t => t.id === state.activeEditingTaskId);
            if (task) {
                task.name = document.getElementById('modalTaskNameInput').value;
                task.responsible = document.getElementById('modalResponsibleInput').value === "true";
                task.isFrog = document.getElementById('modalFrogInput').value === "true";
                task.plannedDay = document.getElementById('modalPlannedDayInput').value;
                task.date = document.getElementById('modalDateInput').value;
                task.priority = document.getElementById('modalPriorityInput').value;
                task.status = document.getElementById('modalStatusInput').value;
                task.pct = Number(document.getElementById('modalPctInput').value) || 0;

                if (task.pct === 100) task.status = 'Fuldført';

                const rawTags = document.getElementById('modalTagsInput').value;
                task.tags = rawTags.split(',').map(t => t.trim()).filter(t => t.length > 0);
                
                recalcTaskProgress(task);
                saveState();
                render();
            }
            closeNoteModal();
        }

        function deleteCurrentTask() {
            if (!state.activeEditingTaskId) return;
            if (confirm('Er du sikker på, at du vil slette denne opgave?')) {
                state.tasks = state.tasks.filter(t => t.id !== state.activeEditingTaskId);
                saveState();
                render();
                closeNoteModal();
            }
        }

        function exportDataToFile() {
            const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(state.tasks, null, 4));
            const link = document.createElement('a');
            link.href = dataStr;
            link.download = 'opgaver_backup.json';
            document.body.appendChild(link);
            link.click();
            link.remove();
        }

        function triggerImportFile() {
            document.getElementById('backupFileInput').click();
        }

        function importDataFromFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    state.tasks = parsed;
                    saveState();
                    render();
                    alert('Backup indlæst korrekt!');
                } catch (error) {
                    alert('Fejl ved indlæsning af backup-filen.');
                }
            };
            reader.readAsText(file);
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadState();
            render();
        });
    </script>
</body>
</html>
