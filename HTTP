<script>
    const STORAGE_KEY = 'workflowdash-state-v1';

    const defaultPriorityColors = {
        Lav: '#3b82f6',
        Mellem: '#f59e0b',
        Høj: '#f43f5e'
    };

    const defaultTasks = [
        { id: 't1', name: 'Overvågning og tømning af betontank', responsible: true, status: 'Igangsat', priority: 'Lav', date: '2026-09-02', pct: 25, note: '', isFrog: false, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't2', name: 'Ændringer til esop måske', responsible: true, status: 'Igangsat', priority: 'Høj', date: '2026-09-07', pct: 10, note: '', isFrog: false, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't3', name: 'Slr måling', responsible: true, status: 'Igangsat', priority: 'Høj', date: '2026-09-02', pct: 0, note: '', isFrog: false, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't4', name: '7 - Ovnbygning: Dæk 2+3 - 6S - Nødvendige eSOPs ikke opdateret', responsible: true, status: 'Igangsat', priority: 'Mellem', date: '2026-09-02', pct: 0, note: '', isFrog: false, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't5', name: 'Tilføjelse til eSOP Trådning af synål', responsible: true, status: 'Igangsat', priority: 'Høj', date: '2026-09-02', pct: 40, note: '', isFrog: true, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't6', name: '3 - BM-bygning - Fældekar - Imprægneringsolietank – område omkring BM-bygning - 6S - Standarder ikke kendte, synlige eller opdaterede', responsible: false, status: 'Igangsat', priority: 'Mellem', date: '2026-09-10', pct: 0, note: '', isFrog: false, plannedDay: 'Torsdag', hours: 0 },
        { id: 't7', name: 'Udeområdet mangler en esop på AQ råvarefyldning', responsible: false, status: 'Venter', priority: 'Lav', date: '2026-09-16', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't8', name: 'eSOP ønskes på visuel kontrol', responsible: true, status: 'Igangsat', priority: 'Høj', date: '2026-09-21', pct: 15, note: '', isFrog: false, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't9', name: 'Omby hættestrækker - trådning af folie', responsible: false, status: 'Igangsat', priority: 'Mellem', date: '2026-08-31', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't10', name: 'CE-mærkning- Produktion GL. pakkeri # 226 side 170', responsible: false, status: 'Igangsat', priority: 'Mellem', date: '2026-08-31', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't11', name: 'trækstyrke (KUN OEM\'er)', responsible: true, status: 'Igangsat', priority: 'Høj', date: '2026-09-02', pct: 50, note: '', isFrog: true, plannedDay: 'Mandag-onsdag', hours: 0 },
        { id: 't12', name: 'Vedligeholdelse af delamineringen (Vokskar tøm og rens)', responsible: true, status: 'Venter', priority: 'Mellem', date: '2026-10-26', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't13', name: 'Opdatering af betjeningsvejledninger', responsible: false, status: 'Igangsat', priority: 'Lav', date: '2026-11-02', pct: 10, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't14', name: 'Rettelse til e-SOP: Spinderskift', responsible: false, status: 'Igangsat', priority: 'Mellem', date: '2026-12-14', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 },
        { id: 't15', name: 'Fines brænder', responsible: true, status: 'Igangsat', priority: 'Mellem', date: '2026-09-02', pct: 0, note: '', isFrog: false, plannedDay: 'Torsdag', hours: 0 },
        { id: 't16', name: 'APV -mek - Udskiftning af pigbånd m.m.', responsible: false, status: 'Igangsat', priority: 'Mellem', date: '2026-08-31', pct: 0, note: '', isFrog: false, plannedDay: 'Ikke planlagt', hours: 0 }
    ];

    const state = {
        tasks: [],
        priorityColors: { ...defaultPriorityColors },
        dashboardPeriodDays: 90,
        hideCalDone: false,
        currentKpiFilter: null,
        searchQuery: '',
        activeEditingTaskId: null,
        theme: 'dark',
        draggedTaskId: null,
        timer: {
            durationSeconds: 25 * 60,
            timeLeft: 25 * 60,
            running: false,
            intervalId: null
        },
        taskTimer: {
            runningTaskId: null,
            intervalId: null
        }
    };

    const refs = {
        periodSelect: document.getElementById('periodSelect'),
        themeSelect: document.getElementById('themeSelect'),
        timeDisplay: document.getElementById('timeDisplay'),
        minutesInput: document.getElementById('minutesInput'),
        startTimerBtn: document.getElementById('startTimerBtn'),
        settingsDropdown: document.getElementById('settingsDropdown'),
        taskTableBody: document.getElementById('taskTableBody'),
        taskSearchInput: document.getElementById('taskSearchInput'),
        responsibleFilter: document.getElementById('responsibleFilter'),
        clearKpiBtn: document.getElementById('clearKpiBtn'),
        noteModal: document.getElementById('noteModal'),
        modalTaskTitle: document.getElementById('modalTaskTitle'),
        modalNoteInput: document.getElementById('modalNoteInput'),
        frogArea: document.getElementById('db-frog-content-area'),
        globalProgressText: document.getElementById('globalProgressText'),
        globalProgressBarFill: document.getElementById('globalProgressBarFill'),
        valDone: document.getElementById('val-done'),
        valActive: document.getElementById('val-active'),
        valLate: document.getElementById('val-late'),
        valTodo: document.getElementById('val-todo'),
        calMonWed: document.getElementById('cal-list-mon-wed'),
        calThu: document.getElementById('cal-list-thu'),
        calFri: document.getElementById('cal-list-fri'),
        backupFileInput: document.getElementById('backupFileInput'),
        colorPickerLav: document.getElementById('colorPickerLav'),
        colorPickerMellem: document.getElementById('colorPickerMellem'),
        colorPickerHoj: document.getElementById('colorPickerHoj')
    };

    function safeParse(value, fallback) {
        try {
            return JSON.parse(value) || fallback;
        } catch (error) {
            return fallback;
        }
    }

    function normalizeTask(task) {
        return {
            id: task.id,
            name: task.name || 'Ny opgave',
            responsible: Boolean(task.responsible),
            status: task.status || 'Igangsat',
            priority: task.priority || 'Mellem',
            date: task.date || new Date().toISOString().split('T')[0],
            pct: Number(task.pct) || 0,
            note: task.note || '',
            isFrog: Boolean(task.isFrog),
            plannedDay: task.plannedDay || 'Ikke planlagt',
            hours: Number(task.hours) || 0
        };
    }

    function loadState() {
        const raw = localStorage.getItem(STORAGE_KEY);
        const saved = safeParse(raw, null);

        if (!saved) {
            state.tasks = defaultTasks.map(normalizeTask);
            return;
        }

        state.tasks = (saved.tasks || defaultTasks).map(normalizeTask);
        state.priorityColors = { ...defaultPriorityColors, ...(saved.priorityColors || {}) };
        state.dashboardPeriodDays = saved.dashboardPeriodDays || 90;
        state.hideCalDone = Boolean(saved.hideCalDone);
        state.theme = saved.theme || 'dark';
        state.timer.durationSeconds = saved.timerDurationSeconds || 25 * 60;
        state.timer.timeLeft = saved.timerTimeLeft || state.timer.durationSeconds;
    }

    function saveState() {
        try {
            const payload = {
                tasks: state.tasks,
                priorityColors: state.priorityColors,
                dashboardPeriodDays: state.dashboardPeriodDays,
                hideCalDone: state.hideCalDone,
                theme: state.theme,
                timerDurationSeconds: state.timer.durationSeconds,
                timerTimeLeft: state.timer.timeLeft
            };
            localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
        } catch (error) {
            console.warn('Kunne ikke gemme state', error);
        }
    }

    function setTheme(themeName) {
        state.theme = themeName;
        document.body.setAttribute('data-theme', themeName);
        refs.themeSelect.value = themeName;
        saveState();
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getTaskColor(priority) {
        return state.priorityColors[priority] || '#3b82f6';
    }

    function switchPage(page) {
        const dashboard = document.getElementById('page-dashboard');
        const tasksPage = document.getElementById('page-tasks');
        const dbNav = document.getElementById('nav-db');
        const taskNav = document.getElementById('nav-tasks');

        dashboard.classList.toggle('active', page === 'dashboard');
        tasksPage.classList.toggle('active', page === 'tasks');
        dbNav.classList.toggle('active', page === 'dashboard');
        taskNav.classList.toggle('active', page === 'tasks');

        if (page === 'dashboard') {
            updateAllGaugesAndStats();
        }
    }

    function toggleSettingsMenu() {
        refs.settingsDropdown.classList.toggle('open');
    }

    window.addEventListener('click', function (event) {
        if (!event.target.closest('.settings-wrapper')) {
            refs.settingsDropdown.classList.remove('open');
        }
    });

    function openNoteModal(taskId) {
        const task = state.tasks.find((item) => item.id === taskId);
        if (!task) return;

        state.activeEditingTaskId = taskId;
        refs.modalTaskTitle.textContent = task.name;
        refs.modalNoteInput.value = task.note || '';
        refs.noteModal.classList.add('open');
    }

    function closeNoteModal() {
        refs.noteModal.classList.remove('open');
        state.activeEditingTaskId = null;
    }

    function saveTaskNote() {
        if (!state.activeEditingTaskId) return;

        const task = state.tasks.find((item) => item.id === state.activeEditingTaskId);
        if (task) {
            task.note = refs.modalNoteInput.value;
            renderTasks();
            updateAllGaugesAndStats();
            saveState();
        }

        closeNoteModal();
    }

    function updatePriorityColor(level, color) {
        state.priorityColors[level] = color;
        renderTasks();
        updateAllGaugesAndStats();
        saveState();
    }

    function setDashboardPeriod(val) {
        state.dashboardPeriodDays = Number(val);
        updateAllGaugesAndStats();
        saveState();
    }

    function isWithinDashboardPeriod(dateStr) {
        if (!dateStr) return false;

        const taskDate = new Date(dateStr);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        taskDate.setHours(0, 0, 0, 0);

        const limitDate = new Date(today);
        limitDate.setDate(today.getDate() + state.dashboardPeriodDays);
        return taskDate <= limitDate;
    }

    function toggleHideCalDone() {
        state.hideCalDone = !state.hideCalDone;
        updateAllGaugesAndStats();
        saveState();
    }

    function clearCalendarDropState() {
        document.querySelectorAll('.calendar-col').forEach((column) => {
            column.classList.remove('drag-over');
        });
    }

    function handleCalendarDragStart(taskId, event) {
        state.draggedTaskId = taskId;
        const draggedCard = event.currentTarget;
        if (draggedCard) draggedCard.classList.add('dragging');
        if (event && event.dataTransfer) {
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', taskId);
        }
    }

    function handleCalendarDragEnter(dayGroup, event) {
        if (!state.draggedTaskId) return;
        event.preventDefault();
        event.currentTarget.classList.add('drag-over');
    }

    function handleCalendarDragLeave(dayGroup, event) {
        if (!state.draggedTaskId) return;
        if (!event.currentTarget.contains(event.relatedTarget)) {
            event.currentTarget.classList.remove('drag-over');
        }
    }

    function handleCalendarDragEnd() {
        state.draggedTaskId = null;
        clearCalendarDropState();
        document.querySelectorAll('.cal-card-item').forEach((card) => card.classList.remove('dragging'));
    }

    function handleCalendarDrop(dayGroup, event) {
        event.preventDefault();
        clearCalendarDropState();
        if (!state.draggedTaskId) return;

        const task = state.tasks.find((item) => item.id === state.draggedTaskId);
        if (!task) return;

        task.plannedDay = dayGroup;
        state.draggedTaskId = null;
        renderTasks();
        updateAllGaugesAndStats();
        saveState();
        document.querySelectorAll('.cal-card-item').forEach((card) => card.classList.remove('dragging'));
    }

    function displayTimer() {
        const minutes = Math.floor(state.timer.timeLeft / 60);
        const seconds = state.timer.timeLeft % 60;
        refs.timeDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }

    function updateDuration() {
        if (state.timer.running) return;

        const mins = Number(refs.minutesInput.value) || 25;
        state.timer.durationSeconds = mins * 60;
        state.timer.timeLeft = state.timer.durationSeconds;
        displayTimer();
        saveState();
    }

    function toggleTimer() {
        const button = refs.startTimerBtn;

        if (state.timer.running) {
            clearInterval(state.timer.intervalId);
            state.timer.running = false;
            button.textContent = 'Start';
            button.style.background = '#f59e0b';
            return;
        }

        state.timer.running = true;
        button.textContent = 'Pause';
        button.style.background = '#f43f5e';

        state.timer.intervalId = setInterval(() => {
            if (state.timer.timeLeft > 0) {
                state.timer.timeLeft -= 1;
                displayTimer();
                saveState();
            } else {
                clearInterval(state.timer.intervalId);
                state.timer.running = false;
                alert('Tiden er gået!');
                resetTimer();
            }
        }, 1000);
    }

    function resetTimer() {
        clearInterval(state.timer.intervalId);
        state.timer.running = false;
        state.timer.timeLeft = state.timer.durationSeconds;
        displayTimer();
        refs.startTimerBtn.textContent = 'Start';
        refs.startTimerBtn.style.background = '#f59e0b';
        saveState();
    }

    function formatHours(value) {
        if (!value) return '0h';
        if (value < 0.1) return `${Math.round(value * 60)}m`;
        return `${value.toFixed(1)}h`;
    }

    function toggleTaskTimer(taskId) {
        if (state.taskTimer.runningTaskId === taskId) {
            clearInterval(state.taskTimer.intervalId);
            state.taskTimer.runningTaskId = null;
            renderTasks();
            updateAllGaugesAndStats();
            return;
        }

        if (state.taskTimer.runningTaskId !== null) {
            clearInterval(state.taskTimer.intervalId);
        }

        state.taskTimer.runningTaskId = taskId;
        renderTasks();
        updateAllGaugesAndStats();

        state.taskTimer.intervalId = setInterval(() => {
            const task = state.tasks.find((item) => item.id === state.taskTimer.runningTaskId);
            if (!task) return;

            task.hours = Number(((task.hours || 0) + 1 / 3600).toFixed(4));
            const taskTimerDisplay = document.getElementById(`dash-timer-text-${task.id}`);
            if (taskTimerDisplay) {
                taskTimerDisplay.textContent = formatHours(task.hours);
            }
            saveState();
        }, 1000);
    }

    function handleSearch() {
        state.searchQuery = refs.taskSearchInput.value.toLowerCase();
        renderTasks();
    }

    function handleFilterChange() {
        renderTasks();
    }

    function kpiClickFilter(type) {
        state.currentKpiFilter = type;
        refs.clearKpiBtn.style.display = 'inline-block';
        switchPage('tasks');
        renderTasks();
    }

    function clearKpiFilter() {
        state.currentKpiFilter = null;
        refs.clearKpiBtn.style.display = 'none';
        renderTasks();
    }

    function updateTaskField(id, field, value) {
        const task = state.tasks.find((item) => item.id === id);
        if (!task) return;

        if (field === 'responsible') {
            task.responsible = value === 'true' || value === true;
        } else if (field === 'isFrog') {
            task.isFrog = value === 'true' || value === true;
        } else if (field === 'pct') {
            task.pct = Math.max(0, Math.min(100, Number(value) || 0));
            if (task.pct === 100) task.status = 'Fuldført';
        } else if (field === 'status') {
            task.status = value;
            if (value === 'Fuldført') task.pct = 100;
        } else {
            task[field] = value;
        }

        renderTasks();
        updateAllGaugesAndStats();
        saveState();
    }

    function addNewTask() {
        const nextId = `t${state.tasks.length + 1}`;
        state.tasks.unshift({
            id: nextId,
            name: 'Ny opgave',
            responsible: true,
            status: 'Igangsat',
            priority: 'Mellem',
            date: new Date().toISOString().split('T')[0],
            pct: 0,
            note: '',
            isFrog: false,
            plannedDay: 'Ikke planlagt',
            hours: 0
        });
        renderTasks();
        updateAllGaugesAndStats();
        saveState();
    }

    function getVisibleTasks() {
        const respFilter = refs.responsibleFilter.value;
        const visible = state.tasks.filter((task) => {
            if (respFilter === 'mine' && !task.responsible) return false;
            if (respFilter === 'not_mine' && task.responsible) return false;
            if (state.searchQuery && !task.name.toLowerCase().includes(state.searchQuery)) return false;
            if (state.currentKpiFilter) {
                if (!isWithinDashboardPeriod(task.date)) return false;
                if (state.currentKpiFilter === 'Kritiske') {
                    if (task.status === 'Fuldført') return false;
                    const diffDays = (new Date(task.date) - new Date()) / (1000 * 60 * 60 * 24);
                    if (diffDays > 7) return false;
                } else if (task.status !== state.currentKpiFilter) {
                    return false;
                }
            }
            return true;
        });

        return visible;
    }

    function renderTasks() {
        refs.taskTableBody.innerHTML = '';
        const visibleTasks = getVisibleTasks();

        visibleTasks.forEach((task) => {
            const prioColor = getTaskColor(task.priority);
            const hasNote = Boolean(task.note && task.note.trim() !== '');

            refs.taskTableBody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td style="text-align:center;">
                        <button class="responsible-btn" title="Klik for at skifte ansvar" onclick="updateTaskField('${task.id}', 'responsible', ${!task.responsible})">
                            ${task.responsible ? '✅' : '❌'}
                        </button>
                    </td>
                    <td style="text-align:center;">
                        <button class="btn-star ${task.isFrog ? 'starred' : ''}" onclick="updateTaskField('${task.id}', 'isFrog', ${!task.isFrog})"><i class="fa-solid fa-star"></i></button>
                    </td>
                    <td>
                        <div class="task-name-click" onclick="openNoteModal('${task.id}')">
                            <input type="text" class="task-name-field" value="${escapeHtml(task.name)}" onchange="updateTaskField('${task.id}', 'name', this.value)" onclick="event.stopPropagation()">
                            ${hasNote ? '<i class="fa-solid fa-comment" style="color:var(--text-muted); font-size:0.8rem;" title="Har kommentar"></i>' : ''}
                        </div>
                    </td>
                    <td>
                        <select class="day-select" onchange="updateTaskField('${task.id}', 'plannedDay', this.value)">
                            <option value="Ikke planlagt" ${task.plannedDay === 'Ikke planlagt' ? 'selected' : ''}>Ikke planlagt</option>
                            <option value="Mandag-onsdag" ${task.plannedDay === 'Mandag-onsdag' ? 'selected' : ''}>Man-Ons</option>
                            <option value="Torsdag" ${task.plannedDay === 'Torsdag' ? 'selected' : ''}>Torsdag</option>
                            <option value="Fredag" ${task.plannedDay === 'Fredag' ? 'selected' : ''}>Fredag</option>
                        </select>
                    </td>
                    <td>
                        <input type="date" value="${task.date}" onchange="updateTaskField('${task.id}', 'date', this.value)">
                    </td>
                    <td>
                        <select class="priority-select" style="color:${prioColor}; border-color:${prioColor};" onchange="updateTaskField('${task.id}', 'priority', this.value)">
                            <option value="Lav" ${task.priority === 'Lav' ? 'selected' : ''}>Lav</option>
                            <option value="Mellem" ${task.priority === 'Mellem' ? 'selected' : ''}>Mellem</option>
                            <option value="Høj" ${task.priority === 'Høj' ? 'selected' : ''}>Høj</option>
                        </select>
                    </td>
                    <td>
                        <select class="status-select" onchange="updateTaskField('${task.id}', 'status', this.value)">
                            <option value="Igangsat" ${task.status === 'Igangsat' ? 'selected' : ''}>Igangsat</option>
                            <option value="Venter" ${task.status === 'Venter' ? 'selected' : ''}>Venter</option>
                            <option value="Fuldført" ${task.status === 'Fuldført' ? 'selected' : ''}>Fuldført</option>
                        </select>
                    </td>
                    <td>
                        <div class="task-progress-wrap">
                            <input type="number" value="${task.pct}" style="width:30px; text-align:center;" min="0" max="100" onchange="updateTaskField('${task.id}', 'pct', this.value)">
                            <span>%</span>
                        </div>
                        <div class="progress-bar"><div class="progress-fill" style="width:${task.pct}%; background:${prioColor};"></div></div>
                    </td>
                    <td style="text-align:center;">
                        <button class="btn-task-timer ${state.taskTimer.runningTaskId === task.id ? 'running' : ''}" onclick="toggleTaskTimer('${task.id}')">
                            <i class="fa-solid ${state.taskTimer.runningTaskId === task.id ? 'fa-stopwatch' : 'fa-play'}"></i>
                        </button>
                    </td>
                </tr>
            `);
        });
    }

    function updateAllGaugesAndStats() {
        const zoneTasks = state.tasks.filter((task) => isWithinDashboardPeriod(task.date) && task.responsible);
        const total = zoneTasks.length;
        const done = zoneTasks.filter((task) => task.status === 'Fuldført').length;
        const active = zoneTasks.filter((task) => task.status === 'Igangsat').length;
        const todo = zoneTasks.filter((task) => task.status === 'Venter').length;
        const late = zoneTasks.filter((task) => task.status !== 'Fuldført' && ((new Date(task.date) - new Date()) / (1000 * 60 * 60 * 24)) <= 7).length;

        refs.valDone.textContent = done;
        refs.valActive.textContent = active;
        refs.valLate.textContent = late;
        refs.valTodo.textContent = todo;

        const totalPct = zoneTasks.reduce((acc, item) => acc + (item.pct || 0), 0);
        const avgPct = total > 0 ? Math.round(totalPct / total) : 0;
        refs.globalProgressText.textContent = `${avgPct}%`;
        refs.globalProgressBarFill.style.width = `${avgPct}%`;

        const frogs = zoneTasks.filter((task) => task.isFrog && task.status !== 'Fuldført');
        refs.frogArea.innerHTML = frogs.length === 0 ? '<div class="empty-state">Ingen aktive fokusopgaver i zonen.</div>' : '';

        frogs.forEach((frog) => {
            const itemColor = getTaskColor(frog.priority);
            const hasNote = frog.note && frog.note.trim() !== '';
            refs.frogArea.insertAdjacentHTML('beforeend', `
                <div class="db-frog-item" onclick="openNoteModal('${frog.id}')">
                    <div style="flex-grow:1;">
                        <div class="db-frog-item-title">
                            <strong>${escapeHtml(frog.name)} ${hasNote ? '<i class="fa-solid fa-comment" style="font-size:0.8rem; color:var(--text-muted);"></i>' : ''}</strong>
                        </div>
                        <div class="db-frog-meta">
                            Planlagt Dato: ${frog.date} | Prioritet: <span style="color:${itemColor}; font-weight:bold;">${frog.priority}</span> | Fremdrift: ${frog.pct}%
                        </div>
                        <div class="db-frog-progress">
                            <div class="db-frog-progress-fill" style="width:${frog.pct}%; background:${itemColor};"></div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:12px;" onclick="event.stopPropagation()">
                        <button class="btn-task-timer ${state.taskTimer.runningTaskId === frog.id ? 'running' : ''}" onclick="toggleTaskTimer('${frog.id}')">
                            <i class="fa-solid ${state.taskTimer.runningTaskId === frog.id ? 'fa-stopwatch' : 'fa-play'}" style="font-size:1.1rem;"></i>
                        </button>
                        <span id="dash-timer-text-${frog.id}" style="font-size:0.9rem; font-weight:bold;">${formatHours(frog.hours)}</span>
                    </div>
                </div>
            `);
        });

        refs.calMonWed.innerHTML = '';
        refs.calThu.innerHTML = '';
        refs.calFri.innerHTML = '';

        zoneTasks.forEach((task) => {
            if (state.hideCalDone && task.status === 'Fuldført') return;

            const itemColor = getTaskColor(task.priority);
            const hasNote = task.note && task.note.trim() !== '';
            const isDone = task.status === 'Fuldført';
            const itemHtml = `
                <div class="cal-card-item ${isDone ? 'status-done' : ''}" draggable="true" style="border-left-color:${itemColor};" onclick="openNoteModal('${task.id}')" ondragstart="handleCalendarDragStart('${task.id}', event)" ondragend="handleCalendarDragEnd()" ondragover="event.preventDefault()">
                    <div class="cal-card-title">
                        ${escapeHtml(task.name)} ${hasNote ? '<i class="fa-solid fa-comment" style="font-size:0.75rem; color:var(--text-muted);"></i>' : ''}
                    </div>
                    <div class="cal-card-footer">
                        <span style="font-weight:bold; color:${itemColor};">${task.pct}%</span>
                        <div class="cal-controls" onclick="event.stopPropagation()">
                            <select class="cal-quick-select" style="color:${itemColor}; border-color:${itemColor};" onchange="updateTaskField('${task.id}', 'priority', this.value)">
                                <option value="Lav" ${task.priority === 'Lav' ? 'selected' : ''}>Lav</option>
                                <option value="Mellem" ${task.priority === 'Mellem' ? 'selected' : ''}>Mellem</option>
                                <option value="Høj" ${task.priority === 'Høj' ? 'selected' : ''}>Høj</option>
                            </select>
                            <select class="cal-quick-select" onchange="updateTaskField('${task.id}', 'plannedDay', this.value)">
                                <option value="Mandag-onsdag" ${task.plannedDay === 'Mandag-onsdag' ? 'selected' : ''}>Man-Ons</option>
                                <option value="Torsdag" ${task.plannedDay === 'Torsdag' ? 'selected' : ''}>Torsdag</option>
                                <option value="Fredag" ${task.plannedDay === 'Fredag' ? 'selected' : ''}>Fredag</option>
                                <option value="Ikke planlagt" ${task.plannedDay === 'Ikke planlagt' ? 'selected' : ''}>Fjern</option>
                            </select>
                        </div>
                    </div>
                </div>
            `;

            if (task.plannedDay === 'Mandag-onsdag') refs.calMonWed.insertAdjacentHTML('beforeend', itemHtml);
            else if (task.plannedDay === 'Torsdag') refs.calThu.insertAdjacentHTML('beforeend', itemHtml);
            else if (task.plannedDay === 'Fredag') refs.calFri.insertAdjacentHTML('beforeend', itemHtml);
        });

        if (!refs.calMonWed.innerHTML) refs.calMonWed.innerHTML = '<div class="empty-state">Ingen opgaver</div>';
        if (!refs.calThu.innerHTML) refs.calThu.innerHTML = '<div class="empty-state">Ingen opgaver</div>';
        if (!refs.calFri.innerHTML) refs.calFri.innerHTML = '<div class="empty-state">Ingen opgaver</div>';
    }

    function exportDataToFile() {
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(state.tasks, null, 4));
        const link = document.createElement('a');
        link.href = dataStr;
        link.download = 'opgaver_backup.json';
        document.body.appendChild(link);
        link.click();
        link.remove();
    }

    function triggerImportFile() {
        refs.backupFileInput.click();
    }

    function importDataFromFile(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            try {
                const parsed = JSON.parse(e.target.result);
                state.tasks = (parsed || []).map(normalizeTask);
                renderTasks();
                updateAllGaugesAndStats();
                saveState();
            } catch (error) {
                alert('Fejl ved indlæsning af filen.');
            }
        };
        reader.readAsText(file);
    }

    function init() {
        loadState();
        refs.periodSelect.value = String(state.dashboardPeriodDays);
        refs.minutesInput.value = String(Math.round(state.timer.durationSeconds / 60));
        refs.themeSelect.value = state.theme;
        refs.colorPickerLav.value = state.priorityColors.Lav;
        refs.colorPickerMellem.value = state.priorityColors.Mellem;
        refs.colorPickerHoj.value = state.priorityColors.Høj;
        setTheme(state.theme);
        displayTimer();
        renderTasks();
        updateAllGaugesAndStats();
    }

    document.addEventListener('DOMContentLoaded', init);
</script>
